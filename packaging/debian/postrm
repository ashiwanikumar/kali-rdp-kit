#!/bin/sh
set -e

case "$1" in
    purge)
        # Config backups are the user's safety net for changes we made to
        # /etc/xrdp; only destroy them on an explicit purge.
        rm -rf /var/lib/kali-rdp-kit
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
