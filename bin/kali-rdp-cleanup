#!/usr/bin/env bash
#
# kali-rdp-cleanup -- reap orphaned xrdp session processes.
#
# Desktops are PERSISTENT by default: disconnecting an RDP client never closes
# your applications, and a disconnected desktop is kept indefinitely so you can
# reconnect to it hours or days later. Only true garbage is reaped -- helper
# processes whose X server is already dead, which hold ports and cause the next
# session to fail to bind.
#
# Opting in to reaping idle desktops (--grace SECONDS) keys the decision on
# whether a client is attached, never on uptime, so a session you are actively
# using is never a candidate.
#
set -uo pipefail

KRK_LIB="${KRK_LIB:-/usr/lib/kali-rdp-kit}"
# shellcheck source=../lib/common.sh
. "$KRK_LIB/common.sh" || { echo "cannot load $KRK_LIB/common.sh" >&2; exit 1; }

GRACE_SECONDS=${KRK_GRACE_SECONDS:-never}
KRK_DRY_RUN=0
VERBOSE=0
REAP_ORPHANS=0
KILL_DISPLAY=""
ASSUME_YES=0
SEEN_FILE=""

usage() {
    cat <<'EOF'
Usage: kali-rdp-cleanup [options]

Reap orphaned xrdp helper processes (xrdp-chansrv, pipewire-xrdp) whose X
server is already gone. These hold VNC ports and make the next session fail to
bind, so they are always reaped.

Desktops themselves are PERSISTENT by default: closing an RDP client does not
close your applications, and a disconnected desktop is kept indefinitely.

Options:
  -n, --dry-run          report what would be killed, change nothing
  -g, --grace SECONDS    also reap desktops left disconnected this long.
                         "never" (the default) keeps them indefinitely.
      --orphans          also reap desktops that sesman no longer tracks. These
                         cannot be reconnected to by any client -- they only
                         hold RAM and their VNC port. Reported, never reaped,
                         unless you pass this.
      --kill DISPLAY     reap one specific desktop (e.g. --kill 18, or :18)
  -y, --yes              do not prompt before killing a desktop in use
  -v, --verbose          also report sessions that were left alone
  -h, --help             this message

Exit status is 0 even when nothing is reaped; it is non-zero only on error.
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        -n|--dry-run) KRK_DRY_RUN=1 ;;
        -g|--grace)   GRACE_SECONDS=${2:?--grace needs a value}; shift ;;
        --orphans)    REAP_ORPHANS=1 ;;
        --kill)       KILL_DISPLAY=${2:?--kill needs a display number}; shift
                      KILL_DISPLAY=${KILL_DISPLAY#:}
                      case $KILL_DISPLAY in
                          ''|*[!0-9]*) die "--kill needs a display number (e.g. 18)" ;;
                      esac ;;
        -y|--yes)     ASSUME_YES=1 ;;
        -v|--verbose) VERBOSE=1 ;;
        -h|--help)    usage; exit 0 ;;
        *)            err "unknown option: $1"; usage >&2; exit 2 ;;
    esac
    shift
done
export KRK_DRY_RUN

# "never" and 0 both mean persistent desktops. Anything else must be a positive
# integer -- a typo here would silently start killing people's sessions.
case $GRACE_SECONDS in
    never|Never|NEVER|0|"") REAP_SESSIONS=0 ;;
    *[!0-9]*) die "--grace must be a number of seconds or \"never\" (got: $GRACE_SECONDS)" ;;
    *) REAP_SESSIONS=1 ;;
esac

krk_init_state

# State lives beside the rest of our state as root, or under XDG when a user
# runs this by hand. Either way it only ever holds "display -> first seen
# disconnected" epochs.
if [ "$(id -u)" -eq 0 ]; then
    SEEN_FILE="$KRK_STATE_DIR/disconnected.state"
else
    SEEN_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/kali-rdp-kit/disconnected.state"
    [ "$KRK_DRY_RUN" = 1 ] || mkdir -p "$(dirname "$SEEN_FILE")"
fi
[ "$KRK_DRY_RUN" = 1 ] || : >>"$SEEN_FILE"

now=$(date +%s)
reaped=0
live_displays=""

# Normalise a DISPLAY value (":18", ":18.0", "18") down to its number.
disp_num() { local d=${1#:}; printf '%s' "${d%%.*}"; }

# Whitespace-delimited membership test, so ":1" never matches ":18".
in_list() {
    local needle=$1 hay=$2 item
    for item in $hay; do [ "$item" = "$needle" ] && return 0; done
    return 1
}

seen_get()  { [ -f "$SEEN_FILE" ] && awk -v d="$1" '$1==d {print $2; exit}' "$SEEN_FILE"; }
seen_set()  {
    [ "$KRK_DRY_RUN" = 1 ] && return 0
    local tmp; tmp=$(mktemp)
    { [ -f "$SEEN_FILE" ] && awk -v d="$1" '$1!=d' "$SEEN_FILE"; echo "$1 $2"; } >"$tmp"
    mv "$tmp" "$SEEN_FILE"
}
seen_clear() {
    [ "$KRK_DRY_RUN" = 1 ] && return 0
    [ -f "$SEEN_FILE" ] || return 0
    local tmp; tmp=$(mktemp)
    awk -v d="$1" '$1!=d' "$SEEN_FILE" >"$tmp"
    mv "$tmp" "$SEEN_FILE"
}

# Kill a process group politely, then firmly.
reap() {
    local pid=$1 what=$2
    kill -0 "$pid" 2>/dev/null || return 0
    if [ "$KRK_DRY_RUN" = 1 ]; then
        printf '%s  would reap%s %s (pid %s)\n' "$C_DIM" "$C_RESET" "$what" "$pid"
        return 0
    fi
    kill -TERM "$pid" 2>/dev/null
    for _ in 1 2 3 4 5; do
        sleep 1
        kill -0 "$pid" 2>/dev/null || { ok "reaped $what (pid $pid)"; return 0; }
    done
    kill -KILL "$pid" 2>/dev/null
    ok "reaped $what (pid $pid, needed SIGKILL)"
}

# Take a whole session down: the X server and every helper hanging off its
# display, so nothing is left holding the socket dir or the VNC port.
reap_session() {
    local display=$1 pid=$2 spid
    for spid in $(pgrep -f "xrdp-chansrv" 2>/dev/null) \
                $(pgrep -f "libpipewire-module-xrdp" 2>/dev/null); do
        [ "$(disp_num "$(krk_proc_env "$spid" DISPLAY)")" = "$display" ] \
            && reap "$spid" "helper for :$display"
    done
    reap "$pid" "Xvnc :$display"
    seen_clear "$display"
}

# --- explicit --kill --------------------------------------------------------

if [ -n "$KILL_DISPLAY" ]; then
    step "Killing :$KILL_DISPLAY"
    target=$(krk_xvnc_inventory | awk -F'\t' -v d="$KILL_DISPLAY" '$2 == d')
    if [ -z "$target" ]; then
        die "no Xvnc is running on display :$KILL_DISPLAY"
    fi
    kpid=$(printf '%s' "$target" | cut -f1)
    kkind=$(printf '%s' "$target" | cut -f5)
    kowner=$(krk_pid_user "$kpid")
    if [ "$kkind" != sesman ]; then
        warn ":$KILL_DISPLAY is a standalone Xvnc (started by hand, not by xrdp)"
    fi
    if krk_display_connected "$KILL_DISPLAY"; then
        warn ":$KILL_DISPLAY has a client attached right now -- ${kowner:-someone} is using it"
        warn "killing it closes every application running in that desktop"
        if [ "$ASSUME_YES" != 1 ] && [ "$KRK_DRY_RUN" != 1 ]; then
            if [ -t 0 ]; then
                printf '  kill it anyway? [y/N] '
                read -r reply
                case $reply in y|Y|yes|YES) ;; *) die "aborted" ;; esac
            else
                die "refusing to kill a desktop in use without --yes"
            fi
        fi
    fi
    reap_session "$KILL_DISPLAY" "$kpid"
    echo
    if [ "$KRK_DRY_RUN" = 1 ]; then
        info "dry run -- nothing was killed"
    else
        info "done"
    fi
    exit 0
fi

step "Xvnc sessions"

INVENTORY=$(krk_xvnc_inventory)

while IFS=$'\t' read -r pid display _depth _geom kind; do
    [ -n "${pid:-}" ] || continue

    # A desktop sesman has forgotten cannot be reconnected to by anything: the
    # session table lives only in sesman's memory, so a restart or a crash
    # leaves the Xvnc running with nobody able to reach it. It is the one class
    # of *desktop* that is genuinely garbage rather than parked work -- but it
    # still contains whatever the user had open, so it is only reaped on
    # request. Standalone servers (vncserver(1) by hand) are never ours to
    # judge and are skipped entirely.
    if [ "$kind" = sesman ] && krk_session_orphaned "$pid"; then
        if [ "$REAP_ORPHANS" = 1 ]; then
            warn ":$display -- untracked by sesman, unreachable; reaping"
            reap_session "$display" "$pid"
            reaped=$(( reaped + 1 ))
        else
            warn ":$display -- untracked by sesman: no client can rejoin it (holding port $(( 5900 + display )))"
            warn "            reap it with: kali-rdp-cleanup --orphans"
            live_displays="$live_displays $display"
        fi
        continue
    fi
    if [ "$kind" != sesman ]; then
        live_displays="$live_displays $display"
        [ "$VERBOSE" = 1 ] && ok ":$display -- standalone Xvnc, not an xrdp session, leaving alone"
        continue
    fi

    if krk_display_connected "$display"; then
        live_displays="$live_displays $display"
        seen_clear "$display"
        [ "$VERBOSE" = 1 ] && ok ":$display -- client attached, leaving alone"
        continue
    fi

    # Persistent mode: a disconnected desktop is somebody's parked work, not
    # garbage. Keep it, and keep its helpers, so reconnecting finds the same
    # windows. Only helpers whose X server is actually gone get reaped below.
    if [ "$REAP_SESSIONS" = 0 ]; then
        live_displays="$live_displays $display"
        ok ":$display -- disconnected, keeping (applications stay running)"
        continue
    fi

    first=$(seen_get "$display")
    if [ -z "$first" ]; then
        seen_set "$display" "$now"
        info ":$display -- unattached, starting ${GRACE_SECONDS}s grace period"
        live_displays="$live_displays $display"
        continue
    fi

    idle=$(( now - first ))
    if [ "$idle" -lt "$GRACE_SECONDS" ]; then
        info ":$display -- unattached for ${idle}s, grace not elapsed"
        live_displays="$live_displays $display"
        continue
    fi

    warn ":$display -- unattached for ${idle}s, reaping session"
    reap_session "$display" "$pid"
    reaped=$(( reaped + 1 ))
done <<<"$INVENTORY"

[ -z "$INVENTORY" ] && log "  (no Xvnc sessions running)"

step "Stray xrdp-chansrv"

# A chansrv whose display no longer has an Xvnc is unambiguously orphaned.
for pid in $(pgrep -f "xrdp-chansrv" 2>/dev/null); do
    d=$(disp_num "$(krk_proc_env "$pid" DISPLAY)")
    if [ -z "$d" ]; then
        [ "$VERBOSE" = 1 ] && warn "chansrv pid $pid -- DISPLAY unreadable, leaving alone"
        continue
    fi
    if ! in_list "$d" "$live_displays"; then
        reap "$pid" "orphaned xrdp-chansrv (:$d)"
        reaped=$(( reaped + 1 ))
    elif [ "$VERBOSE" = 1 ]; then
        ok "xrdp-chansrv for :$d -- session live, leaving alone"
    fi
done

step "Stray pipewire xrdp modules"

# xrdp's pipewire module is launched per session via pw-cli and is *not* torn
# down when the session dies -- it reparents to init and lingers forever. Match
# it back to its display and reap the ones whose session is gone.
for pid in $(pgrep -f "libpipewire-module-xrdp" 2>/dev/null); do
    d=$(disp_num "$(krk_proc_env "$pid" DISPLAY)")
    if [ -z "$d" ]; then
        # No DISPLAY to match on. Only reap if it has been reparented to init
        # and no session is running at all -- otherwise leave it be.
        if [ "$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')" = "1" ] \
           && [ -z "$INVENTORY" ]; then
            reap "$pid" "orphaned pipewire-xrdp module (no live sessions)"
            reaped=$(( reaped + 1 ))
        elif [ "$VERBOSE" = 1 ]; then
            warn "pw-cli pid $pid -- DISPLAY unreadable, leaving alone"
        fi
        continue
    fi
    if ! in_list "$d" "$live_displays"; then
        reap "$pid" "orphaned pipewire-xrdp module (:$d)"
        reaped=$(( reaped + 1 ))
    elif [ "$VERBOSE" = 1 ]; then
        ok "pipewire-xrdp for :$d -- session live, leaving alone"
    fi
done

echo
if [ "$KRK_DRY_RUN" = 1 ]; then
    info "dry run -- nothing was killed"
else
    info "done -- reaped $reaped process(es)"
fi
