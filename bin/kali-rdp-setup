#!/usr/bin/env bash
#
# kali-rdp-setup -- make xrdp on Kali actually work, idempotently.
#
# Every change is backed up under /var/lib/kali-rdp-kit/backups/<timestamp>/
# and every step is safe to re-run.
#
set -uo pipefail

KRK_LIB="${KRK_LIB:-/usr/lib/kali-rdp-kit}"
KRK_SHARE="${KRK_SHARE:-/usr/share/kali-rdp-kit}"
# shellcheck source=../lib/common.sh
. "$KRK_LIB/common.sh" || { echo "cannot load $KRK_LIB/common.sh" >&2; exit 1; }

KRK_DRY_RUN=0
KEEP_DM=0
NO_TMUX=0
NO_TIMER=0
NO_RESTART=0
ASSUME_YES=0
REAP_DISCONNECTED=""
RDP_PORT=""
MAX_BPP=""
SECURITY_LAYER=""
CHANGED=0

usage() {
    cat <<'EOF'
Usage: sudo kali-rdp-setup [options]

Configure xrdp on Kali for reliable headless RDP:
  * disable the display manager that fights RDP for the console session
  * force the Xvnc backend (Kali has no xorgxrdp package)
  * keep disconnected desktops alive, so closing a client never closes apps
  * install a cleanup timer for orphaned helper processes
  * drop in a tmux config that stops multi-client redraw corruption

Desktops are persistent by default: disconnecting an RDP client leaves your
applications running, and reconnecting returns you to them.

Options:
  -n, --dry-run            print what would change, change nothing
      --keep-dm            leave lightdm/gdm3/sddm alone (console GUI needed)
      --port PORT          set the xrdp listening port (default: leave as-is)
      --max-bpp N          cap colour depth at N (8|15|16|24|32). Set this when
                           you connect from several devices: xrdp keys sessions
                           on colour depth, so a phone negotiating a different
                           depth than your desktop gets a SEPARATE desktop.
                           Capping low makes every client converge on one.
      --security-layer L   tls | negotiate | rdp. Defaults to tls, because
                           Kali ships a self-signed certificate and letting
                           clients negotiate against one causes intermittent
                           handshake failures and black screens on reconnect.
      --reap-disconnected S close desktops left disconnected for S seconds.
                           Off by default -- this CLOSES USERS' APPLICATIONS.
      --no-tmux            skip the tmux config
      --no-timer           skip the cleanup systemd timer
      --no-restart         apply the changes but do not restart xrdp. Restarting
                           makes sesman forget every running desktop, so use this
                           when someone is working in one.
  -y, --yes                do not prompt, even when a restart would orphan a
                           running desktop
  -h, --help               this message
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        -n|--dry-run)        KRK_DRY_RUN=1 ;;
        --keep-dm)           KEEP_DM=1 ;;
        --port)              RDP_PORT=${2:?--port needs a value}; shift ;;
        --max-bpp)           MAX_BPP=${2:?--max-bpp needs a value}; shift
                             case $MAX_BPP in
                                 8|15|16|24|32) ;;
                                 *) die "--max-bpp must be one of 8, 15, 16, 24, 32" ;;
                             esac ;;
        --reap-disconnected) REAP_DISCONNECTED=${2:?--reap-disconnected needs a value}; shift
                             case $REAP_DISCONNECTED in
                                 ''|*[!0-9]*) die "--reap-disconnected needs a number of seconds" ;;
                             esac ;;
        --security-layer)    SECURITY_LAYER=${2:?--security-layer needs a value}; shift
                             case $SECURITY_LAYER in
                                 tls|negotiate|rdp) ;;
                                 *) die "--security-layer must be tls, negotiate or rdp" ;;
                             esac ;;
        --no-tmux)           NO_TMUX=1 ;;
        --no-timer)          NO_TIMER=1 ;;
        --no-restart)        NO_RESTART=1 ;;
        -y|--yes)            ASSUME_YES=1 ;;
        -h|--help)           usage; exit 0 ;;
        *)                   err "unknown option: $1"; usage >&2; exit 2 ;;
    esac
    shift
done
export KRK_DRY_RUN

require_root
krk_init_state

SESMAN_INI="$KRK_XRDP_DIR/sesman.ini"
XRDP_INI="$KRK_XRDP_DIR/xrdp.ini"

note_change() { CHANGED=$(( CHANGED + 1 )); }

printf '%skali-rdp-setup %s%s\n' "$C_BOLD" "$KRK_VERSION" "$C_RESET"
[ "$KRK_DRY_RUN" = 1 ] && info "dry run -- no changes will be made"
[ "$KRK_DRY_RUN" = 1 ] || info "backups: $KRK_BACKUP_DIR/$KRK_RUN_ID"

# --- 1. packages ------------------------------------------------------------

step "1. Packages"

missing=""
for pkg in xrdp tigervnc-standalone-server; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" \
        || missing="$missing $pkg"
done
[ "$NO_TMUX" = 0 ] && ! have tmux && missing="$missing tmux"

if [ -n "$missing" ]; then
    info "installing:$missing"
    run env DEBIAN_FRONTEND=noninteractive apt-get update -qq
    # shellcheck disable=SC2086
    run env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $missing \
        || die "package installation failed"
    note_change
else
    ok "all required packages present"
fi

# xorgxrdp is simply not in Kali's repos; that is why the Xorg backend hangs.
if [ "$(apt-cache policy xorgxrdp 2>/dev/null | awk '/Candidate:/{print $2}')" = "(none)" ]; then
    ok "xorgxrdp unavailable as expected -- using the Xvnc backend"
fi

# --- 2. display manager -----------------------------------------------------

step "2. Display manager"

if [ "$KEEP_DM" = 1 ]; then
    warn "--keep-dm given; leaving display managers enabled"
    warn "a console session on :0 shares this user's D-Bus and ICEauthority with"
    warn "RDP sessions, which is the usual cause of session-start races"
else
    touched_dm=0
    for dm in lightdm gdm3 sddm; do
        systemctl list-unit-files "$dm.service" >/dev/null 2>&1 || continue
        if systemctl is-enabled "$dm" >/dev/null 2>&1; then
            info "disabling $dm (console GUI is not needed for RDP)"
            run systemctl disable --now "$dm"
            note_change; touched_dm=1
        fi
    done
    [ "$touched_dm" -eq 0 ] && ok "no display manager enabled"
    # Without a DM the box should boot to multi-user, or systemd starts one anyway.
    current_target=$(systemctl get-default 2>/dev/null)
    if [ "$current_target" = "graphical.target" ]; then
        info "switching default target to multi-user.target"
        run systemctl set-default multi-user.target
        note_change
    else
        ok "default target is $current_target"
    fi
fi

# --- 3. xrdp backend --------------------------------------------------------

step "3. xrdp backend"

[ -f "$XRDP_INI" ] || die "$XRDP_INI missing -- is xrdp installed?"

if ! grep -qE '^\[Xvnc\]' "$XRDP_INI"; then
    die "no [Xvnc] section in xrdp.ini; refusing to guess at its contents"
fi
ok "[Xvnc] session type present"

# Comment out the Xorg entry so the login dropdown cannot offer a backend that
# will hang. Leave the section body intact so --keep-dm users can restore it.
if grep -qE '^\[Xorg\]' "$XRDP_INI" && ! krk_xorgxrdp_usable; then
    info "disabling the unusable [Xorg] session type"
    if [ "$KRK_DRY_RUN" = 1 ]; then
        printf '%s  would comment out%s [Xorg] in xrdp.ini\n' "$C_DIM" "$C_RESET"
    else
        backup_file "$XRDP_INI"
        tmp=$(mktemp)
        awk '/^\[Xorg\]/ { print "; disabled by kali-rdp-setup: no xorgxrdp on Kali"
                           print ";" $0; in_x = 1; next }
             /^\[/      { in_x = 0 }
             in_x && NF { print ";" $0; next }
             { print }' "$XRDP_INI" >"$tmp" && cat "$tmp" >"$XRDP_INI"
        rm -f "$tmp"
    fi
    note_change
else
    ok "no conflicting Xorg session type to disable"
fi

if [ -n "$RDP_PORT" ]; then
    if ini_set "$XRDP_INI" Globals port "$RDP_PORT"; then
        info "xrdp port set to $RDP_PORT"; note_change
    else
        ok "xrdp port already $RDP_PORT"
    fi
else
    ok "listening port left at $(ini_get "$XRDP_INI" Globals port)"
fi

# xrdp's session-allocation Policy always includes the B (bits-per-pixel)
# criterion and it cannot be switched off, so two clients negotiating different
# colour depths get two separate desktops for the same user. Capping the depth
# server-side makes every client that asks for at least the cap converge on one
# session -- which is what you want when a phone and a laptop should reach the
# same running work.
if [ -n "$MAX_BPP" ]; then
    # Changing the cap strands any desktop already running at a different
    # depth: the B criterion will never match it again, so it keeps running
    # with the user's work in it and no client can reach it. Nothing is killed
    # -- but "my apps vanished" is exactly how that feels, so say it first.
    stranded=$(ps -eo args= 2>/dev/null | awk -v cap="$MAX_BPP" '
        /[X]vnc :[0-9]+/ {
            disp=""; depth=""
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^:[0-9]+$/) disp = $i
                if ($i == "-depth") depth = $(i + 1)
            }
            if (disp != "" && depth != "" && depth + 0 != cap + 0)
                print disp "@" depth "bpp"
        }')
    if [ -n "$stranded" ]; then
        warn "running desktops at a different colour depth will become UNREACHABLE:"
        for _s in $stranded; do warn "    ${_s%@*} (${_s#*@})"; done
        warn "nothing is killed -- they keep running, but no client can rejoin them"
        warn "log out of them first, or set --max-bpp to their depth to get back in"
    fi
    if ini_set "$XRDP_INI" Globals max_bpp "$MAX_BPP"; then
        info "max_bpp=$MAX_BPP -- clients requesting more will be capped to it"
        note_change
    else
        ok "max_bpp already $MAX_BPP"
    fi
    [ "$MAX_BPP" -gt 16 ] 2>/dev/null && \
        warn "a client asking for less than $MAX_BPP still gets its own session; 16 converges more clients"
else
    ok "colour depth left at max_bpp=$(ini_get "$XRDP_INI" Globals max_bpp)"
fi

# Xvnc must stay bound to loopback; xrdp is the only thing that should reach it.
if grep -qE '^\s*param=-localhost' "$SESMAN_INI"; then
    ok "Xvnc restricted to localhost"
else
    warn "Xvnc is not started with -localhost; its VNC port may be world-reachable"
    warn "add 'param=-localhost' under [Xvnc] in $SESMAN_INI"
fi

# xrdp runs as an unprivileged user but must read the TLS key, which Debian
# ships as root:ssl-cert 0640. Without group membership the handshake fails
# with an unhelpful "xrdp_sec_incoming failed" and clients drop at random.
key_path=$(ini_get "$XRDP_INI" Globals key_file)
[ -n "$key_path" ] || key_path="$KRK_XRDP_DIR/key.pem"
runtime_user=$(ini_get "$XRDP_INI" Globals runtime_user)
runtime_user=${runtime_user:-xrdp}

key_group_fixed=0
key_group=""
if krk_path_present "$key_path" && id "$runtime_user" >/dev/null 2>&1; then
    key_group=$(stat -L -c '%G' "$key_path" 2>/dev/null)
    if [ -n "$key_group" ] && [ "$key_group" != "root" ] \
       && ! id -nG "$runtime_user" 2>/dev/null | tr ' ' '\n' | grep -qx "$key_group"; then
        info "adding $runtime_user to group $key_group so it can read the TLS key"
        run usermod -aG "$key_group" "$runtime_user"
        # Group membership only applies to processes started afterwards, so the
        # xrdp running right now still cannot read the key. The restart at the
        # end of this run is what actually completes the fix.
        key_group_fixed=1
        note_change
    elif [ -n "$key_group" ]; then
        ok "$runtime_user can reach the TLS key (group $key_group)"
    else
        ok "TLS key present at $key_path"
    fi
fi

# --- security layer ---------------------------------------------------------
#
# Kali ships xrdp with security_layer=negotiate and a self-signed snakeoil
# certificate. With `negotiate` the client picks between RDP security, TLS and
# CredSSP; presented with a certificate it cannot validate, some clients --
# mstsc most visibly -- fail or flip-flop on that choice, and most often on a
# reconnect after a previous session was left in a stale state. The connection
# dies before a window manager ever starts, so the user sees a black screen and
# a drop, and the server logs only "xrdp_sec_incoming failed", which says
# nothing about the cause. Pinning `tls` removes the choice and the flakiness
# with it. This is why the default here differs from Kali's shipped default.
#
# The one thing that must never happen is pinning tls on a host with no usable
# certificate: that turns an intermittently failing server into a permanently
# failing one. So the cert and key are verified first, and a missing pair
# downgrades the change to advice rather than applying it.
cert_path=$(ini_get "$XRDP_INI" Globals certificate)
[ -n "$cert_path" ] || cert_path="$KRK_XRDP_DIR/cert.pem"
current_layer=$(ini_get "$XRDP_INI" Globals security_layer)
want_layer=${SECURITY_LAYER:-tls}

# Pinning tls on a host whose key xrdp cannot read would turn an intermittent
# fault into a permanent one, so the change is gated on the key being usable.
# The gate has to be careful in both directions: refusing to apply the fix
# because the *test* was inconclusive is its own failure mode.
tls_usable=1
if ! krk_path_present "$cert_path" || ! krk_path_present "$key_path"; then
    tls_usable=0
    warn "TLS certificate or key missing ($cert_path / $key_path)"
    warn "generate them first, then re-run this:"
    warn "  sudo make-ssl-cert generate-default-snakeoil --force-overwrite"
else
    key_real=$(readlink -f "$key_path" 2>/dev/null || printf '%s' "$key_path")
    krk_can_read_as "$runtime_user" "$key_real"
    case $? in
        0) ;;                       # verified readable
        1) if [ "$key_group_fixed" = 1 ] || [ "$KRK_DRY_RUN" = 1 ]; then
               # Expected: the group was added moments ago and takes effect at
               # the restart that ends this run.
               :
           else
               tls_usable=0
               warn "$runtime_user cannot read the TLS key; not forcing security_layer=tls"
               warn "fix the key permissions first, or TLS would fail for every client"
           fi ;;
        *) # Could not impersonate runtime_user at all. Fall back to group
           # membership, which is the condition the read test would have been
           # measuring anyway.
           if [ -z "$key_group" ] \
              || id -nG "$runtime_user" 2>/dev/null | tr ' ' '\n' | grep -qx "$key_group" \
              || [ "$key_group_fixed" = 1 ]; then
               warn "could not verify the key read as $runtime_user; proceeding on group membership"
           else
               tls_usable=0
               warn "could not verify the key read as $runtime_user, and it is not in group '$key_group'"
               warn "not forcing security_layer=tls"
           fi ;;
    esac
fi

if [ "$want_layer" = tls ] && [ "$tls_usable" = 0 ]; then
    warn "leaving security_layer=${current_layer:-negotiate} until TLS is usable"
elif [ -n "$SECURITY_LAYER" ] || [ "${current_layer:-negotiate}" != tls ]; then
    if [ "$want_layer" != tls ] && [ "$want_layer" != "$current_layer" ]; then
        warn "security_layer=$want_layer was requested explicitly"
        [ "$want_layer" = rdp ] && warn "  rdp is legacy, unencrypted RDP security"
        [ "$want_layer" = negotiate ] && \
            warn "  with a self-signed certificate this is a known source of intermittent handshake failures"
    fi
    if ini_set "$XRDP_INI" Globals security_layer "$want_layer"; then
        info "security_layer=$want_layer (was ${current_layer:-unset, i.e. negotiate})"
        note_change
    else
        ok "security_layer already $want_layer"
    fi
else
    ok "security_layer already tls"
fi

# TLS 1.0/1.1 are refused outright by current clients; offering them cannot
# help and reads as a misconfiguration to anyone auditing the host.
protos=$(ini_get "$XRDP_INI" Globals ssl_protocols)
case $protos in
    *TLSv1.0*|*TLSv1.1*)
        if ini_set "$XRDP_INI" Globals ssl_protocols "TLSv1.2, TLSv1.3"; then
            info "ssl_protocols=TLSv1.2, TLSv1.3 (was $protos)"; note_change
        fi ;;
    *) ok "ssl_protocols=${protos:-default}" ;;
esac

if krk_path_present "$cert_path"; then
    days_left=$(krk_cert_days_left "$cert_path" 2>/dev/null) || days_left=""
    if [ -n "$days_left" ] && [ "$days_left" -lt 0 ] 2>/dev/null; then
        warn "the TLS certificate expired $(( -days_left )) day(s) ago"
        warn "  sudo make-ssl-cert generate-default-snakeoil --force-overwrite"
    fi
fi

# --- 4. disconnected session policy ----------------------------------------

step "4. Disconnected session policy"

[ -f "$SESMAN_INI" ] || die "$SESMAN_INI missing"

# Persistent by default: closing an RDP client must never close the user's
# applications. sesman ignores these keys on the Xvnc backend anyway, but they
# are set explicitly so behaviour does not silently change the day xorgxrdp
# appears in the archive.
if [ -z "$REAP_DISCONNECTED" ]; then
    if ini_set "$SESMAN_INI" Sessions KillDisconnected false; then
        info "KillDisconnected=false -- disconnected desktops are kept"; note_change
    else
        ok "KillDisconnected already false (desktops persist)"
    fi
    ok "disconnected desktops persist indefinitely; applications keep running"
else
    if ini_set "$SESMAN_INI" Sessions KillDisconnected true; then
        info "KillDisconnected=true"; note_change
    else
        ok "KillDisconnected already true"
    fi
    if ini_set "$SESMAN_INI" Sessions DisconnectedTimeLimit "$REAP_DISCONNECTED"; then
        info "DisconnectedTimeLimit=$REAP_DISCONNECTED"; note_change
    else
        ok "DisconnectedTimeLimit already $REAP_DISCONNECTED"
    fi
    warn "desktops disconnected longer than ${REAP_DISCONNECTED}s will be closed"
fi

# --- 5. cleanup timer -------------------------------------------------------

step "5. Orphan cleanup timer"

if [ "$NO_TIMER" = 1 ]; then
    warn "--no-timer given; skipping"
elif [ -f /usr/lib/systemd/system/kali-rdp-cleanup.timer ] \
  || [ -f /lib/systemd/system/kali-rdp-cleanup.timer ]; then
    if systemctl is-enabled kali-rdp-cleanup.timer >/dev/null 2>&1; then
        ok "kali-rdp-cleanup.timer already enabled"
    else
        run systemctl daemon-reload
        run systemctl enable --now kali-rdp-cleanup.timer
        info "kali-rdp-cleanup.timer enabled"; note_change
    fi
else
    warn "cleanup timer unit not installed (running from a git checkout?)"
    warn "install the package, or copy share/systemd/*.{service,timer} to /etc/systemd/system"
fi

# Keep the reaper's idea of the policy identical to sesman's, or the two
# disagree about whether a parked desktop is garbage.
if [ -n "$REAP_DISCONNECTED" ] && [ "$NO_TIMER" != 1 ]; then
    override_dir=/etc/systemd/system/kali-rdp-cleanup.service.d
    run mkdir -p "$override_dir"
    if [ "$KRK_DRY_RUN" = 1 ]; then
        printf '%s  would set%s KRK_GRACE_SECONDS=%s for kali-rdp-cleanup\n' \
            "$C_DIM" "$C_RESET" "$REAP_DISCONNECTED"
    else
        printf '[Service]\nEnvironment=KRK_GRACE_SECONDS=%s\n' "$REAP_DISCONNECTED" \
            >"$override_dir/grace.conf"
        run systemctl daemon-reload
        info "cleanup will reap desktops disconnected over ${REAP_DISCONNECTED}s"
        note_change
    fi
elif [ -f /etc/systemd/system/kali-rdp-cleanup.service.d/grace.conf ]; then
    # Returning to the default must actually undo the opt-in.
    info "removing previous reap-disconnected override (desktops now persist)"
    run rm -f /etc/systemd/system/kali-rdp-cleanup.service.d/grace.conf
    run systemctl daemon-reload
    note_change
fi

# A user crontab calling the old cleanup script will fight this timer.
if crontab -l -u "${SUDO_USER:-root}" 2>/dev/null | grep -q "cleanup-xrdp"; then
    warn "found a cleanup-xrdp.sh entry in ${SUDO_USER:-root}'s crontab"
    warn "remove it -- it reaps by uptime and will kill sessions you are using:"
    warn "  crontab -e"
fi

# --- 6. tmux ----------------------------------------------------------------

step "6. tmux configuration"

if [ "$NO_TMUX" = 1 ]; then
    warn "--no-tmux given; skipping"
else
    target_user=${SUDO_USER:-root}
    target_home=$(getent passwd "$target_user" | cut -d: -f6)
    src="$KRK_SHARE/tmux.conf"
    dst="$target_home/.tmux.conf"
    if [ ! -f "$src" ]; then
        warn "$src not found (running from a git checkout?); skipping"
    elif [ -f "$dst" ] && grep -q "kali-rdp-kit" "$dst" 2>/dev/null; then
        ok "tmux config already managed by kali-rdp-kit"
    elif [ -f "$dst" ]; then
        warn "$dst exists and is not ours; leaving it alone"
        warn "to adopt our settings: cat $src >> $dst"
    else
        run install -o "$target_user" -g "$target_user" -m 0644 "$src" "$dst"
        info "installed $dst"; note_change
    fi
fi

# --- 7. restart -------------------------------------------------------------

step "7. Restart services"

# Restarting is not free, and the cost is not the few seconds of downtime.
#
# sesman holds its session table in memory. Stopping it forgets every desktop,
# while the Xvnc processes themselves survive -- they run in a logind session
# scope rather than the unit's cgroup, so systemd does not take them down. What
# is left is a desktop that is still running, still holding VNC port
# 5900+display, and that no client can ever rejoin: reconnecting builds a new
# empty one beside it. That is the whole of "my session disconnected and then I
# could not get back in".
#
# There is no way to restart xrdp without taking sesman with it -- sesman is
# BindsTo=xrdp.service -- so the only honest options are to say what will be
# lost, or not to restart. Both are offered here.
inventory_snapshot=$(krk_xvnc_inventory)
live_desktops=$(printf '%s' "$inventory_snapshot" | awk -F'\t' '$5 == "sesman" { print $2 }')
n_live=$(printf '%s' "$live_desktops" | grep -c . || true)

if [ "$CHANGED" -eq 0 ]; then
    ok "nothing changed; not restarting xrdp"
elif [ "$NO_RESTART" = 1 ]; then
    warn "--no-restart given; the changes are on disk but not yet in effect"
    warn "apply them when nobody is working in a desktop:"
    warn "  sudo systemctl restart xrdp"
else
    # The warning is worth just as much on a dry run -- more, even: reviewing
    # what a run would cost is exactly what --dry-run is for.
    if [ "${n_live:-0}" -gt 0 ]; then
        warn "restarting will make sesman forget ${n_live} running desktop(s):"
        for _d in $live_desktops; do
            _who=$(printf '%s' "$inventory_snapshot" | awk -F'\t' -v d="$_d" '$2 == d { print $1 }')
            warn "    :$_d  (owner $(krk_pid_user "$_who"))"
        done
        warn "they keep running and their applications are not killed, but no client"
        warn "can rejoin them afterwards -- reconnecting will build a new empty desktop"
        warn "log out of them first, or re-run with --no-restart to apply this later"
    fi

    if [ "${n_live:-0}" -gt 0 ] && [ "$KRK_DRY_RUN" != 1 ]; then
        if [ "$ASSUME_YES" != 1 ] && [ -t 0 ]; then
            printf '  restart anyway? [y/N] '
            read -r _reply
            case $_reply in
                y|Y|yes|YES) ;;
                *) warn "not restarting; the changes are on disk"
                   warn "apply them later with: sudo systemctl restart xrdp"
                   NO_RESTART=1 ;;
            esac
        elif [ "$ASSUME_YES" != 1 ]; then
            # Non-interactive and desktops are live: refusing is the only safe
            # default. A cron job or a piped installer must not silently strand
            # somebody's work.
            warn "no terminal to confirm on; not restarting"
            warn "re-run with --yes to restart anyway, or --no-restart to silence this"
            NO_RESTART=1
        fi
    fi

    if [ "$NO_RESTART" != 1 ]; then
        info "restarting xrdp and xrdp-sesman"
        run systemctl enable xrdp xrdp-sesman >/dev/null 2>&1
        run systemctl restart xrdp-sesman
        run systemctl restart xrdp
    fi
fi

# A restart that failed leaves a host with no RDP at all, and the exit status
# of `systemctl restart` does not always catch it. Check what actually happened.
if [ "$KRK_DRY_RUN" != 1 ] && [ "$CHANGED" -gt 0 ] && [ "$NO_RESTART" != 1 ]; then
    if ! systemctl is-active --quiet xrdp; then
        err "xrdp is not running after the restart"
        log "  sudo journalctl -u xrdp -n 50 --no-pager"
        exit 1
    fi
    listen_port=$(ini_get "$XRDP_INI" Globals port)
    listen_port=${listen_port:-3389}
    # xrdp.ini also accepts forms like "tcp://:3389" and "vsock://...", and a
    # host may not have iproute2 at all. Failing the whole run because the
    # *verification* could not be performed would be a false alarm about a
    # server that is fine, so an unverifiable listener is a note, not an error.
    case $listen_port in
        *[!0-9]*) note_port="" ;;
        *)        note_port=$listen_port ;;
    esac
    if [ -z "$note_port" ] || ! have ss; then
        warn "could not verify the listener (port '$listen_port'); xrdp itself is running"
    else
        # The listener can take a moment to bind after the unit reports active.
        for _ in 1 2 3 4 5; do
            ss -tlnH 2>/dev/null | grep -q ":$note_port " && break
            sleep 1
        done
        if ss -tlnH 2>/dev/null | grep -q ":$note_port "; then
            ok "xrdp is listening on port $note_port"
        else
            err "xrdp is running but nothing is listening on port $note_port"
            log "  sudo journalctl -u xrdp -n 50 --no-pager"
            exit 1
        fi
    fi
fi

echo
if [ "$KRK_DRY_RUN" = 1 ]; then
    info "dry run complete -- $CHANGED change(s) would have been made"
else
    info "setup complete -- $CHANGED change(s) made"
    log "  verify with: kali-rdp-doctor"
fi
